import tkinter as tk
from tkinter import ttk 

Seasons = {
    "season1": {
        "name": "Season 1",
        "months": "January - March",
        "description": "This is the first season.",
        "meaning": "The meaning of season 1.",
    },
    "season2": {
        "name": "Season 2",
        "months": "April - June",
        "description": "This is the second season.",
        "meaning": "The meaning of season 2.",
    },
}

class SeasonApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Season Details")
        self.root.geometry("600x400")

        main_frame = tk.Frame(root)
        main_frame.pack(fill="both", expand=True)

        left_panel = tk.Frame(main_frame, bg="#e0e0e0", bd=1, relief="solid")
        left_panel.pack(side="left", fill="y")

        self.season_list = tk.Listbox(left_panel, font=("Segoe UI", 12))
        self.season_list.pack(fill="both", expand=True, padx=10, pady=10)
        for season in Seasons:
            self.season_list.insert(tk.END, Seasons[season]["name"])

        self.season_list.bind("<<ListboxSelect>>", self.update_details)

        Title = tk.Label(main_frame, text="Season Details", font=("Segoe UI", 16, "bold"))
        Title.pack(anchor="w", padx=20, pady=(10, 0))